<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed so the settings app can write /sdcard/XclipseRDNA/xclipse.env -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="Xclipse RDNA Renderer"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <!-- ===== FCL renderer plugin registration =====
             Layout follows the plugin format used by ShirosakiMio/FCLRendererPlugin,
             Ironized Zink and other FCL plugins:
               fclPlugin = true
               renderer  = "<Display name>:<GL lib>:<EGL lib>"   (libs from nativeLibraryDir)
               pojavEnv  = KEY=VALUE pairs separated by ':'      (injected into the game env)
             NOTE: verify field names/separators against the FCL release you target. -->
        <meta-data android:name="fclPlugin" android:value="true" />
        <meta-data android:name="des" android:value="Zink/Kopper tuned for Exynos 1580 (Xclipse 540, RDNA 3)" />
        <!-- The plugin owns both sides of the renderer pair, the way working launcher plugins do
             (MobileGL declares its own library as both GL and EGL). Pointing the EGL field at Mesa's
             libEGL_mesa.so left the launcher loading a library outside the APK, whose context
             creation failed and whose NULL version string crashed the launcher's EGL bridge. -->
        <meta-data android:name="renderer"
            android:value="Xclipse RDNA:libglxshim.so:libEGL_xclipse.so" />
        <!-- No MESA_GL_VERSION_OVERRIDE / MESA_GLSL_VERSION_OVERRIDE here on purpose: forcing 4.6 on a
             Vulkan driver that cannot back it makes Zink fail to create a context, and the launcher's
             GL version probe then crashes on the NULL string. The settings app writes those
             overrides only when you explicitly ask for GL 3.3.
             mesa_glthread stays off: the Mesa glthread batch thread is a known crash source with
             Kopper on vendor Vulkan drivers. Turn it back on with the "Performance" preset. -->
        <meta-data android:name="pojavEnv"
            android:value="POJAV_RENDERER=opengles3_desktopgl_zink_kopper:MESA_LOADER_DRIVER_OVERRIDE=zink:mesa_glthread=false:DLOPEN=libxclipse_shim.so" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
